NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=mysql://ahoden_dev_app:replace-with-local-secret@127.0.0.1:3306/ahoden_elite_clean_dev
MIGRATION_DATABASE_URL=mysql://ahoden_dev_migrator:replace-with-local-secret@127.0.0.1:3306/ahoden_elite_clean_dev
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
BODY_LIMIT=100kb
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
OWNER_BOOTSTRAP_TOKEN=replace-with-at-least-24-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

