{
  "info": {
    "_postman_id": "ace10000-0000-4000-8000-000000000001",
    "name": "Ahoden Elite Clean Backend",
    "description": "Executable requests are added milestone by milestone. M03 uses conspicuously labelled nonproduction catalogue fixtures and server-calculated GHS amounts.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "M01 Foundation",
      "item": [
        {
          "name": "Health - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Public liveness probe; role: none; expected 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is safe health response', () => pm.expect(pm.response.json()).to.eql({status: 'ok'}));",
                  "pm.test('request ID is returned', () => pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Readiness - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ready",
            "description": "Public readiness probe with MariaDB available; role: none; expected 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('database is ready', () => pm.expect(pm.response.json()).to.eql({status: 'ready'}));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Unknown route - 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/not-yet-implemented",
            "description": "Negative case; role: none; expected 404 standard envelope."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('standard error envelope', () => { const json = pm.response.json(); pm.expect(json.error.code).to.eql('NOT_FOUND'); pm.expect(json.requestId).to.eql(pm.response.headers.get('x-request-id')); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Malformed JSON - 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"broken\":"
            },
            "url": "{{baseUrl}}/api/v1/not-yet-implemented",
            "description": "Negative case; role: none; deliberately malformed body; expected 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('safe malformed JSON error', () => pm.expect(pm.response.json().error).to.eql({code: 'MALFORMED_JSON', message: 'Request body contains malformed JSON.'}));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "M02 Authentication",
      "description": "Automated customer registration/login/me flow plus negative field-injection and invalid-login cases. Uses a run-unique email.",
      "item": [
        {
          "name": "Register customer - 201",
          "event": [{"listen":"prerequest","script":{"type":"text/javascript","exec":["if (!pm.collectionVariables.get('m02Email')) pm.collectionVariables.set('m02Email', `postman-${Date.now()}@example.test`);"]}},{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status is 201', () => pm.response.to.have.status(201));","const json=pm.response.json(); pm.expect(json.user.role).to.eql('customer'); pm.collectionVariables.set('m02UserId', json.user.id);"]}}],
          "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{m02Email}}\",\"displayName\":\"Postman Customer\",\"password\":\"Postman password 1!\"}"},"url":"{{baseUrl}}/api/v1/auth/register"}
        },
        {
          "name": "Reject role injection - 400",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status is 400', () => pm.response.to.have.status(400));","pm.test('validation envelope', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"]}}],
          "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"injection@example.test\",\"displayName\":\"Injected\",\"password\":\"Postman password 1!\",\"role\":\"owner\"}"},"url":"{{baseUrl}}/api/v1/auth/register"}
        },
        {
          "name": "Invalid login is generic - 401",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status is 401', () => pm.response.to.have.status(401));","pm.test('generic message', () => pm.expect(pm.response.json().error.message).to.eql('Email or password is invalid.'));"]}}],
          "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{m02Email}}\",\"password\":\"Wrong password!\"}"},"url":"{{baseUrl}}/api/v1/auth/login"}
        },
        {
          "name": "Login customer - 200",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status is 200', () => pm.response.to.have.status(200));","pm.collectionVariables.set('m02AccessToken', pm.response.json().accessToken);"]}}],
          "request": {"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{m02Email}}\",\"password\":\"Postman password 1!\"}"},"url":"{{baseUrl}}/api/v1/auth/login"}
        },
        {
          "name": "Current user - 200",
          "event": [{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('status is 200', () => pm.response.to.have.status(200));","pm.test('same customer', () => pm.expect(pm.response.json().user.id).to.eql(pm.collectionVariables.get('m02UserId')));"]}}],
          "request": {"method":"GET","header":[{"key":"Authorization","value":"Bearer {{m02AccessToken}}"}],"url":"{{baseUrl}}/api/v1/auth/me"}
        }
      ]
    },
    {
      "name": "M03 Catalogue and Quotes",
      "description": "Automated public catalogue, customer-owned address, server-calculated quote, client-amount rejection, and out-of-zone cases. M02 Authentication must run first to supply the customer access token.",
      "item": [
        {
          "name": "List active services - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('development fixture is explicitly labelled', () => { const service = pm.response.json().data.find((item) => item.id === pm.environment.get('m03ServiceId')); pm.expect(service).to.be.an('object'); pm.expect(service.developmentOnly).to.eql(true); pm.expect(service.indicativePrice.currency).to.eql('GHS'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/services",
            "description": "Public active catalogue; role: none; expected 200."
          }
        },
        {
          "name": "Create in-zone customer address - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('m03AddressId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{m02AccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"label\":\"Postman Home\",\"addressLine1\":\"1 Development Street\",\"locality\":\"Oyarifa\",\"region\":\"Greater Accra\"}"
            },
            "url": "{{baseUrl}}/api/v1/addresses",
            "description": "Customer-owned address; role: customer; expected 201."
          }
        },
        {
          "name": "Create server-calculated quote - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('amount and tax are server calculated', () => { const quote = pm.response.json().data; pm.expect(quote.currency).to.eql('GHS'); pm.expect(quote.subtotalMinor).to.eql(55000); pm.expect(quote.tax).to.eql({basisPoints: 0, amountMinor: 0}); pm.expect(quote.totalMinor).to.eql(55000); pm.expect(quote.bookable).to.eql(true); });",
                  "pm.collectionVariables.set('m03QuoteId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{m02AccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"serviceId\":\"{{m03ServiceId}}\",\"addressId\":\"{{m03AddressId}}\",\"startsAt\":\"{{m03StartsAt}}\",\"inputs\":{\"bedrooms\":2}}"
            },
            "url": "{{baseUrl}}/api/v1/quotes",
            "description": "Server-calculated immutable quote; role: customer; expected 201."
          }
        },
        {
          "name": "Reject client quote amount - 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('amount injection is validation error', () => pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{m02AccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"serviceId\":\"{{m03ServiceId}}\",\"addressId\":\"{{m03AddressId}}\",\"startsAt\":\"{{m03StartsAt}}\",\"inputs\":{\"bedrooms\":2},\"totalMinor\":1}"
            },
            "url": "{{baseUrl}}/api/v1/quotes",
            "description": "Negative amount injection; role: customer; expected 400."
          }
        },
        {
          "name": "Create out-of-zone customer address - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('m03OutsideAddressId', pm.response.json().data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{m02AccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"label\":\"Outside\",\"addressLine1\":\"2 Development Street\",\"locality\":\"Kumasi\",\"region\":\"Ashanti\"}"
            },
            "url": "{{baseUrl}}/api/v1/addresses",
            "description": "Out-of-zone fixture address; role: customer; expected 201."
          }
        },
        {
          "name": "Reject out-of-zone quote - 409",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('zone rejection is explicit', () => pm.expect(pm.response.json().error.code).to.eql('ADDRESS_OUT_OF_ZONE'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{m02AccessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"serviceId\":\"{{m03ServiceId}}\",\"addressId\":\"{{m03OutsideAddressId}}\",\"startsAt\":\"{{m03StartsAt}}\",\"inputs\":{\"bedrooms\":2}}"
            },
            "url": "{{baseUrl}}/api/v1/quotes",
            "description": "Negative service-area case; role: customer; expected 409."
          }
        }
      ]
    },
    {
      "name": "M01 Manual dependency failure",
      "description": "Stop only the local XAMPP MySQL service, start the API, then run this folder. This is intentionally excluded from the automated smoke folder.",
      "item": [
        {
          "name": "Readiness - 503 when database is down",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 503', () => pm.response.to.have.status(503));",
                  "pm.test('database details are concealed', () => { const json = pm.response.json(); pm.expect(json.error.code).to.eql('DATABASE_UNAVAILABLE'); pm.expect(JSON.stringify(json)).not.to.include('mysql://'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}

