{
  "info": {
    "_postman_id": "ace10000-0000-4000-8000-000000000001",
    "name": "Ahoden Elite Clean Backend",
    "description": "Executable requests are added milestone by milestone. M01 has no authentication fixtures.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "M01 Foundation",
      "item": [
        {
          "name": "Health - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Public liveness probe; role: none; expected 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is safe health response', () => pm.expect(pm.response.json()).to.eql({status: 'ok'}));",
                  "pm.test('request ID is returned', () => pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string').and.not.empty);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Readiness - 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ready",
            "description": "Public readiness probe with MariaDB available; role: none; expected 200."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('database is ready', () => pm.expect(pm.response.json()).to.eql({status: 'ready'}));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Unknown route - 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/not-yet-implemented",
            "description": "Negative case; role: none; expected 404 standard envelope."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));",
                  "pm.test('standard error envelope', () => { const json = pm.response.json(); pm.expect(json.error.code).to.eql('NOT_FOUND'); pm.expect(json.requestId).to.eql(pm.response.headers.get('x-request-id')); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Malformed JSON - 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"broken\":"
            },
            "url": "{{baseUrl}}/api/v1/not-yet-implemented",
            "description": "Negative case; role: none; deliberately malformed body; expected 400."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('safe malformed JSON error', () => pm.expect(pm.response.json().error).to.eql({code: 'MALFORMED_JSON', message: 'Request body contains malformed JSON.'}));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "M01 Manual dependency failure",
      "description": "Stop only the local XAMPP MySQL service, start the API, then run this folder. This is intentionally excluded from the automated smoke folder.",
      "item": [
        {
          "name": "Readiness - 503 when database is down",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ready"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status is 503', () => pm.response.to.have.status(503));",
                  "pm.test('database details are concealed', () => { const json = pm.response.json(); pm.expect(json.error.code).to.eql('DATABASE_UNAVAILABLE'); pm.expect(JSON.stringify(json)).not.to.include('mysql://'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}

