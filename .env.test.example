NODE_ENV=test
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=silent
DATABASE_URL=mysql://ahoden_test_app:replace-with-local-secret@127.0.0.1:3306/ahoden_elite_clean_test
MIGRATION_DATABASE_URL=mysql://ahoden_test_migrator:replace-with-local-secret@127.0.0.1:3306/ahoden_elite_clean_test
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
BODY_LIMIT=100kb
ALLOW_TEST_DATABASE_RESET=true
TEST_DATABASE_ALLOWED_HOSTS=127.0.0.1,localhost,mysql
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
OWNER_BOOTSTRAP_TOKEN=replace-with-at-least-24-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

