{
  "name": "ahoden-elite-clean-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Ahoden Elite Clean modular backend API",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean --silent && tsc",
    "test": "npm run test:unit && npm run test:api && npm run test:integration",
    "test:unit": "npm run build --silent && node --env-file-if-exists=.env.test.local ./node_modules/mocha/bin/mocha.js --reporter spec \"dist/tests/unit/**/*.test.js\"",
    "test:api": "npm run build --silent && node --env-file-if-exists=.env.test.local ./node_modules/mocha/bin/mocha.js --reporter spec \"dist/tests/api/**/*.test.js\"",
    "test:integration": "npm run db:test:reset --silent && npm run build --silent && node --env-file-if-exists=.env.test.local ./node_modules/mocha/bin/mocha.js --reporter spec --timeout 30000 \"dist/tests/integration/**/*.test.js\"",
    "test:postman": "postman collection run postman/Ahoden_Backend.postman_collection.json -e postman/Ahoden_Local.postman_environment.json -i \"M01 Foundation\" -i \"M02 Authentication\"",
    "db:migrate": "npm run build --silent && node dist/scripts/database/migrate.js",
    "db:rollback": "npm run build --silent && node dist/scripts/database/rollback.js",
    "db:seed:test": "npm run build --silent && node --env-file-if-exists=.env.test.local dist/scripts/database/seed-test.js",
    "db:test:reset": "npm run build --silent && node --env-file-if-exists=.env.test.local dist/scripts/database/reset-test.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "knex": "3.3.0",
    "mysql2": "3.24.5",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chai": "5.2.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "chai": "6.3.0",
    "eslint": "10.12.0",
    "mocha": "12.0.3",
    "postman-cli": "1.73.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "allowScripts": {
    "postman-cli@1.73.0": true,
    "esbuild@0.28.2": true
  }
}
